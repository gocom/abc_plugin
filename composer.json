{
    "name": "rah/abc_plugin",
    "description": "A plugin template",
    "keywords": ["textpattern", "plugin"],
    "homepage": "https://github.com/gocom/abc_plugin",
    "license": "GPL-2.0",
    "type": "textpattern-plugin",
    "authors": [
        {
            "name": "Jukka Svahn",
            "homepage": "https://github.com/gocom",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/gocom/abc_plugin/issues",
        "source": "https://github.com/gocom/abc_plugin"
    },
    "autoload-dev": {
        "psr-4": {
            "Abc\\Plugin\\Test\\": "test/"
        }
    },
    "require": {
        "textpattern/lock": ">=4.4.1",
        "textpattern/installer": "*"
    },
    "require-dev": {
        "rah/mtxpc": "^0.9.0",
        "squizlabs/php_codesniffer": "3.*",
        "phpunit/phpunit": "^13.3",
        "antecedent/patchwork": "^2.2"
    },
    "scripts": {
        "test": [
            "@composer lint",
            "@composer test:unit"
        ],
        "lint": "./vendor/bin/phpcs",
        "lint-fix": "./vendor/bin/phpcbf",
        "compile": "mtxpc --outdir=dist/ -c . && mtxpc --outdir=dist/ .",
        "test:unit": "XDEBUG_MODE=coverage phpunit"
    },
    "config": {
        "allow-plugins": {
            "textpattern/installer": true
        }
    }
}
